generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  user
}

enum BadgeKey {
  first_exact_score
  on_a_roll
  perfect_week
  group_champion
  season_champion
  season_podium
  group_season_champion
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum MatchStatus {
  scheduled
  live
  finished
  postponed
  cancelled
}

enum Winner {
  home
  away
  draw
}

enum ChampionBonusStatus {
  OPEN     // picks editable
  LOCKED   // picks frozen, awards accruing
}

model User {
  id                Int           @id @default(autoincrement())
  name              String
  email             String        @unique
  password          String
  role              Role          @default(user)
  avatarUrl         String?
  notificationEmail String?
  currentStreak     Int           @default(0)
  longestStreak     Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  predictions       Prediction[]
  groupMembers      GroupMember[]
  deviceTokens      DeviceToken[]
  badges            UserBadge[]
  seasonStandings   SeasonStanding[]
  championBonusPicks ChampionBonusPick[]
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    BadgeKey
  earnedAt DateTime @default(now())

  @@unique([userId, badge])
  @@index([userId])
}

model League {
  id          Int          @id @default(autoincrement())
  externalId  Int          @unique
  name        String
  country     String
  logo        String?
  season      Int
  isActive    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  teamLeagues TeamLeague[]
  matches     Match[]
  championBonuses ChampionBonus[]
}

model Team {
  id          Int          @id @default(autoincrement())
  externalId  Int          @unique
  name        String
  logo        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  teamLeagues TeamLeague[]
  championBonusTeams ChampionBonusTeam[]
  championBonusPicks ChampionBonusPick[]
  championBonusAwards ChampionBonusAward[]
}

model TeamLeague {
  id               Int      @id @default(autoincrement())
  teamId           Int
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leagueId         Int
  league           League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  externalLeagueId Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([teamId, leagueId])
  @@index([leagueId])
  @@index([externalLeagueId])
}

model Match {
  id               Int          @id @default(autoincrement())
  externalId       Int?         @unique
  leagueId         Int?
  league           League?      @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  externalLeagueId Int
  homeTeamExtId    Int
  homeTeamName     String
  homeTeamLogo     String?
  awayTeamExtId    Int
  awayTeamName     String
  awayTeamLogo     String?
  kickoffTime      DateTime
  status           MatchStatus  @default(scheduled)
  matchday         Int?
  stage            String?
  leg              Int?
  venue            String?
  resultHomeScore        Int?
  resultAwayScore        Int?
  resultPenaltyHomeScore Int?
  resultPenaltyAwayScore Int?
  resultWinner           Winner?
  scoresProcessed  Boolean      @default(false)
  weekStart        DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  seasonId         Int?
  season           Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  predictions      Prediction[]
  matchOdds        MatchOdds?
  championBonusAwards ChampionBonusAward[]

  @@index([status, kickoffTime])
  @@index([externalLeagueId, kickoffTime])
  @@index([seasonId])
}

model Prediction {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId          Int
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeScore        Int
  awayScore        Int
  predictedWinner  Winner
  pointsAwarded    Int      @default(0)
  baseScore        Int      @default(0)
  finalScore       Int      @default(0)
  outcomeOdds      Decimal  @default(1.0) @db.Decimal(4, 2)
  scoringBreakdown Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId, createdAt(sort: Desc)])
}

model ScoringRule {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  key         String   @unique
  points      Int
  priority    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id        Int           @id @default(autoincrement())
  name      String
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members         GroupMember[]
  seasonStandings SeasonStanding[]
}

model GroupMember {
  id      Int   @id @default(autoincrement())
  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model TeamStanding {
  id               Int      @id @default(autoincrement())
  externalTeamId   Int
  externalLeagueId Int
  season           Int
  position         Int
  played           Int
  won              Int
  drawn            Int
  lost             Int
  points           Int
  goalsFor         Int
  goalsAgainst     Int
  goalDifference   Int
  form             String?
  updatedAt        DateTime @updatedAt

  @@unique([externalTeamId, externalLeagueId])
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Season {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  status      SeasonStatus     @default(DRAFT)
  startDate   DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  oddsEnabled Boolean          @default(false)
  oddsMin     Decimal          @default(1.1) @db.Decimal(4, 2)
  oddsMax     Decimal          @default(5.0) @db.Decimal(4, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  matches     Match[]
  standings   SeasonStanding[]
  championBonus ChampionBonus?
}

model MatchOdds {
  id             Int       @id @default(autoincrement())
  matchId        Int       @unique
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeWinVotes   Int       @default(0)
  drawVotes      Int       @default(0)
  awayWinVotes   Int       @default(0)
  homeWinOdds    Decimal   @default(1.10) @db.Decimal(4, 2)
  drawOdds       Decimal   @default(3.05) @db.Decimal(4, 2)
  awayWinOdds    Decimal   @default(5.00) @db.Decimal(4, 2)
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SeasonStanding {
  id               Int      @id @default(autoincrement())
  seasonId         Int
  season           Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  groupId          Int?
  group            Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank             Int
  totalPoints      Int
  totalPredictions Int
  exactScores      Int
  recordedAt       DateTime @default(now())

  @@index([seasonId, groupId])
  @@index([userId])
}

model ChampionBonus {
  id        Int                 @id @default(autoincrement())
  seasonId  Int                 @unique          // one config (one league) per season
  season    Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  leagueId  Int
  league    League              @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  status    ChampionBonusStatus @default(OPEN)
  lockedAt  DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  teams     ChampionBonusTeam[]
  picks     ChampionBonusPick[]
  awards    ChampionBonusAward[]
}

model ChampionBonusTeam {          // admin-selected allowed subset
  id              Int           @id @default(autoincrement())
  championBonusId Int
  championBonus   ChampionBonus @relation(fields: [championBonusId], references: [id], onDelete: Cascade)
  teamId          Int
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([championBonusId, teamId])
}

model ChampionBonusPick {
  id              Int           @id @default(autoincrement())
  championBonusId Int
  championBonus   ChampionBonus @relation(fields: [championBonusId], references: [id], onDelete: Cascade)
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId          Int
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([championBonusId, userId])   // one pick per user
  @@index([championBonusId, teamId])
}

model ChampionBonusAward {            // ONE row per (team, counted match) — not per user
  id              Int           @id @default(autoincrement())
  championBonusId Int
  championBonus   ChampionBonus @relation(fields: [championBonusId], references: [id], onDelete: Cascade)
  teamId          Int
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchId         Int
  match           Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber      Int           // Nth counted game since lock, 1-based
  isWin           Boolean       // based on resultWinner (penalty wins count)
  points          Int           // isWin ? 2^min(gameNumber, 20) : 0   (cap prevents Int overflow)

  @@unique([championBonusId, teamId, matchId])
  @@index([championBonusId, teamId])
}
